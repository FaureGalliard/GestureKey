{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GestureKey",
  "version": "3.2.0-beta.1",
  "identifier": "com.faure.gesturekey",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GestureKey",
        "width": 980,
        "height": 640,
        "minWidth": 820,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#141415"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "GestureKey overlay",
        "width": 440,
        "height": 96,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:8765; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/": "engine/"
    },
    "publisher": "Angel Crispin",
    "copyright": "© 2026 Angel Gabriel Crispin Valdivia",
    "category": "Utility",
    "shortDescription": "Controla tu PC con gestos de la mano",
    "longDescription": "GestureKey reconoce gestos de la mano con la webcam para desplazar, cambiar el volumen, hacer zoom, mover ventanas entre monitores y más.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
