{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GestureKey",
  "version": "3.0.0",
  "identifier": "com.faure.gesturekey",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GestureKey",
        "width": 1040,
        "height": 660,
        "minWidth": 800,
        "minHeight": 540,
        "decorations": false,
        "backgroundColor": "#0c0c0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:8765; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/": "engine/"
    }
  }
}
