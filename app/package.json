{
  "name": "gesturekey-app",
  "private": true,
  "version": "3.2.0-beta.1",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "engine": "uv run --project ../engine python -m gesturekey",
    "engine:debug": "uv run --project ../engine python -m gesturekey --debug",
    "build:engine": "uv run --project ../engine pyinstaller ../engine/gesturekey-engine.spec --noconfirm --distpath src-tauri/engine --workpath ../engine/build",
    "release": "pnpm build:engine && pnpm tauri build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@tauri-apps/api": "^2.5.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
